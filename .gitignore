# dependencies
/node_modules
# npm workspaces (packages/*) can get their own nested node_modules for
# workspace-specific deps not hoisted to the root — /node_modules above only
# anchors to the repo root and would miss these.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# workspace package build output — built by `npm run build`/`predev`,
# never committed (same reasoning as /.next/); see packages/ui/package.json.
/packages/*/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets, only .env.example is tracked
.env
.env.local
.env*.local
.env.development
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# supabase CLI local link cache (machine-specific, regenerated by `supabase link`)
supabase/.temp/
