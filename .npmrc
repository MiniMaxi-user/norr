# The design-system package (@yourorg/ui) is published to a private registry
# from its own repo/pipeline — never consumed as a local path in this app.
# Point the @yourorg scope at that registry and authenticate via an env var
# (set NPM_TOKEN in your shell for local dev, and as a secret in GitHub
# Actions / Vercel). Replace the registry URL once the design-system repo's
# publish target is finalized (e.g. GitHub Packages or a private npm registry).
@yourorg:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
