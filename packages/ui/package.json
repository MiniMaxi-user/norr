{
  "name": "@yourorg/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Norr's internal design system. Lives inside this monorepo (npm workspace package, not a published registry package) so the app and its design system iterate in the same PR. The app must only ever import from '@yourorg/ui' / '@yourorg/ui/icons' / '@yourorg/ui/styles.css' — never reach into src/ or dist/ directly.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/copy-css.mjs",
    "dev": "tsup --watch --onSuccess \"node ./scripts/copy-css.mjs\"",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "next": "*",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.14",
    "tsup": "^8.3.5",
    "typescript": "^5",
    "vite": "^5.4.11"
  }
}
