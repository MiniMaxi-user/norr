{
  "name": "norr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @yourorg/ui && npm run build -w @yourorg/rbac",
    "dev": "next dev",
    "prebuild": "npm run build -w @yourorg/ui && npm run build -w @yourorg/rbac",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "npm run typecheck -w @yourorg/ui && npm run build -w @yourorg/ui && npm run typecheck -w @yourorg/rbac && npm run build -w @yourorg/rbac",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no test runner configured yet (tracked separately) \" && exit 0"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/speed-insights": "^2.0.0",
    "@yourorg/rbac": "*",
    "@yourorg/ui": "*",
    "leaflet": "^1.9.4",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.2.3",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "typescript": "^5"
  }
}
